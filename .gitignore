# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.env
.venv
venv/
env/

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data files (archivos pesados — solo se versionan muestras o datos de ejemplo)
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.json
data/raw/*.parquet
!data/raw/.gitkeep

data/processed/*.csv
data/processed/*.xlsx
data/processed/*.json
data/processed/*.parquet
!data/processed/.gitkeep

# Modelos entrenados
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.pth
!models/.gitkeep

# Reportes generados
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.svg
!reports/figures/.gitkeep

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
